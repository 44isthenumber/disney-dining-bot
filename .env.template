# ── Disney Auth ─────────────────────────────────────────────────────────────
# Grab these from DevTools > Application > Cookies on disneyworld.disney.go.com
# after logging in.  Steps:
#   1. Open https://disneyworld.disney.go.com/dine-res/restaurant/jaleo
#   2. Open DevTools (F12) → Application → Cookies
#   3. Copy the full value of each cookie below

DISNEY_TOKEN_BLOB=<full value of TPR-WDW-LBJS.WEB-PROD.token cookie>
DISNEY_SWID={472548C4-228E-4B48-B549-A7D2AEC346C0}
DISNEY_AKACD=<full value of akacd_dineplan cookie>
DISNEY_ABCK=<full value of _abck cookie>
DISNEY_BM_SZ=<full value of bm_sz cookie>


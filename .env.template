# ── Disney Browser Session ─────────────────────────────────────────────────
# Production polling uses a persistent Playwright browser profile on the VPS.
# Seed it with:
#   python3 -m playwright install chromium
#   DISNEY_HEADLESS=false python3 seed_disney_session.py
DISNEY_BROWSER_MODE=playwright
DISNEY_BROWSER_PROFILE_DIR=.browser-profile
DISNEY_HEADLESS=true

# ── Website Users ───────────────────────────────────────────────────────────
# Each user gets their own login password and phone number. Watches created by
# that user only text that user's phone.
WATCH_USERS={"craig":{"name":"Craig","password":"change-me","phone":"+1xxxxxxxxxx"},"wife":{"name":"Wife","password":"change-me-too","phone":"+1xxxxxxxxxx"}}
DEFAULT_OWNER_ID=craig

# Legacy shared password fallback if WATCH_USERS is not set.
API_SECRET=change-me

# ── Twilio SMS ──────────────────────────────────────────────────────────────
# Sign up at https://twilio.com — free trial includes ~$15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx   # your Twilio number


# ── Disney Browser Session ─────────────────────────────────────────────────
# Production polling uses a persistent Playwright browser profile on the VPS.
# Seed it with:
#   python3 -m playwright install chromium
#   DISNEY_HEADLESS=false xvfb-run -a python3 seed_disney_session.py
DISNEY_BROWSER_MODE=playwright
# Use an absolute path on the VPS so the same seeded browser profile persists
# across systemd runs.
DISNEY_BROWSER_PROFILE_DIR=/opt/disney-dining-bot/.browser-profile
# MUST be "false" on the VPS. Akamai aborts truly-headless Chromium with
# ERR_HTTP2_PROTOCOL_ERROR; the systemd service runs xvfb-run for a virtual
# display so "headed" Chromium runs without a real GUI.
DISNEY_HEADLESS=false
# Optional dedicated bot account credentials for seed_disney_session.py only.
# Never commit real values. If Disney asks for MFA/CAPTCHA/security checks,
# the script pauses for manual completion.
DISNEY_LOGIN_EMAIL=
DISNEY_LOGIN_PASSWORD=
# Hours between proactive SMS nags when auto session recovery fails (default 24).
SESSION_MANUAL_ALERT_COOLDOWN_HOURS=24

# ── Website Users ───────────────────────────────────────────────────────────
# Each user gets their own login password and phone number. Watches created by
# that user only alert that user's phone. The phone field is a channel-prefixed
# recipient handled by notify.py:
#   signal:+1xxxxxxxxxx       -> Signal via local signal-cli (production)
#   signal:<account-uuid>     -> Signal by UUID, used when Signal "phone-number
#                                discoverability" is OFF (privacy-on-by-default)
#   whatsapp:+1xxxxxxxxxx     -> Twilio WhatsApp (legacy / fallback only)
#   +1xxxxxxxxxx              -> Twilio SMS (legacy / fallback only)
# Operational alerts (session expired, recovery failed) route only to the admin
# user (DEFAULT_OWNER_ID, or DISNEY_ALERT_ADMIN if set). Reservation alerts
# remain owner-scoped per-watch.
WATCH_USERS='{"craig":{"name":"Craig","password":"change-me","phone":"signal:<uuid-or-+1xxxxxxxxxx>"},"Jessica":{"name":"Jessica","password":"change-me-too","phone":"signal:+1xxxxxxxxxx"}}'
DEFAULT_OWNER_ID=craig
# Optional: override which user receives operational/failure alerts.
# DISNEY_ALERT_ADMIN=craig

# Fallback users when WATCH_USERS is absent (e.g., Netlify deployment).
# These profiles have no phone numbers and share the API_SECRET password.
FALLBACK_USERS='{"craig":{"name":"Craig"},"Jessica":{"name":"Jessica"}}'

# Legacy shared password fallback if WATCH_USERS is not set.
API_SECRET=change-me

# ── Signal (primary alert channel) ─────────────────────────────────────────
# Phone number the bot's signal-cli account sends FROM. Register a dedicated
# number (Google Voice works) with Signal via signal-cli on the VPS — see
# VPS_DEPLOYMENT.md § 3a for the end-to-end setup.
SIGNAL_BOT_NUMBER=+1xxxxxxxxxx
# Optional override for the signal-cli binary path (default /usr/local/bin/signal-cli)
# SIGNAL_CLI_PATH=/usr/local/bin/signal-cli

# ── Twilio (legacy / fallback channel) ─────────────────────────────────────
# Only used for recipients with a `whatsapp:` or bare `+1...` phone prefix.
# Production uses Signal; these are kept so the existing A2P 10DLC paperwork
# isn't lost if you ever want to fall back.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx   # or whatsapp:+1xxxxxxxxxx for WhatsApp


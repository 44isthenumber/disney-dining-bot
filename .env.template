# ── Disney Browser Session ─────────────────────────────────────────────────
# Production polling uses a persistent Playwright browser profile on the VPS.
# Seed it with:
#   python3 -m playwright install chromium
#   DISNEY_HEADLESS=false xvfb-run -a python3 seed_disney_session.py
DISNEY_BROWSER_MODE=playwright
# Use an absolute path on the VPS so the same seeded browser profile persists
# across systemd runs.
DISNEY_BROWSER_PROFILE_DIR=/opt/disney-dining-bot/.browser-profile
DISNEY_HEADLESS=true
# Optional dedicated bot account credentials for seed_disney_session.py only.
# Never commit real values. If Disney asks for MFA/CAPTCHA/security checks,
# the script pauses for manual completion.
DISNEY_LOGIN_EMAIL=
DISNEY_LOGIN_PASSWORD=
# Hours between proactive SMS nags when auto session recovery fails (default 24).
SESSION_MANUAL_ALERT_COOLDOWN_HOURS=24

# ── Website Users ───────────────────────────────────────────────────────────
# Each user gets their own login password and phone number. Watches created by
# that user only alert that user's phone. Use +1... for SMS or whatsapp:+1...
# for Twilio WhatsApp sandbox/sender routing.
WATCH_USERS='{"craig":{"name":"Craig","password":"change-me","phone":"whatsapp:+1xxxxxxxxxx"},"Jessica":{"name":"Jessica","password":"change-me-too","phone":"whatsapp:+1xxxxxxxxxx"}}'
DEFAULT_OWNER_ID=craig

# Fallback users when WATCH_USERS is absent (e.g., Netlify deployment).
# These profiles have no phone numbers and share the API_SECRET password.
FALLBACK_USERS='{"craig":{"name":"Craig"},"Jessica":{"name":"Jessica"}}'

# Legacy shared password fallback if WATCH_USERS is not set.
API_SECRET=change-me

# ── Twilio SMS / WhatsApp ──────────────────────────────────────────────────
# Sign up at https://twilio.com — free trial includes ~$15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=whatsapp:+1xxxxxxxxxx   # or +1xxxxxxxxxx for regular SMS

# ── Gist Storage ────────────────────────────────────────────────────────────
GITHUB_GIST_ID=7e8d8f873715971f8989a25a2f22c089
GITHUB_TOKEN=github_pat_xxx

